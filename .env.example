# Privy App ID - Get from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=PRIVY_APP_ID

# Solana RPC URL. Use devnet for testing; mainnet for production.
# Devnet: https://api.devnet.solana.com or Helius devnet
# Mainnet: Helius, QuickNode, etc. e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Network: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Starpay API Token - Get from Starpay dashboard
STARPAY_API_TOKEN=your-starpay-api-token

# ============================================
# Privacy Cash Configuration
# ============================================
# Note: Privacy Cash requires Node.js 24+ and uses the 'privacycash' npm package
# Fees: Deposit 0, Withdrawal 0.006 SOL + 0.35%
# Docs: https://privacycash.mintlify.app/

# Optional: Helius API key for /api/sol-price (Helius DAS getAsset). If unset, we use
# api-key from NEXT_PUBLIC_SOLANA_RPC_URL when it's a Helius URL; else CoinGecko fallback.
HELIUS_API_KEY=your-helius-api-key

# ============================================
# Private Gift Card Configuration
# ============================================
# Email configuration for receiving card details from Starpay
# The system uses cards+{orderId}@yourdomain.com format

# IMAP server settings (for polling card delivery emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=cards@hoppy.cash
IMAP_PASSWORD=your-app-password

# Email address format settings
EMAIL_PREFIX=cards
EMAIL_DOMAIN=hoppy.cash

# Secret for authenticating cron job calls to /api/card/poll-emails
CRON_SECRET=your-random-secret-string

# Public app URL (for generating claim links)
NEXT_PUBLIC_APP_URL=https://hoppy.cash

# ============================================
# Database Configuration (Railway PostgreSQL)
# ============================================
# Railway auto-injects this when you link a PostgreSQL database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hoppy
