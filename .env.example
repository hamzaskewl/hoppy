# Solana RPC URL. Use devnet for testing; mainnet for production.
# Devnet: https://api.devnet.solana.com or Helius devnet
# Mainnet: Helius, QuickNode, etc. e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Network: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# ============================================
# Bitrefill API (gift cards)
# ============================================
# Get an API key at https://bitrefill.com/account/developers
BITREFILL_API_KEY=your-bitrefill-api-key

# Bitrefill REST base URL — change only if Bitrefill issues you a sandbox URL
BITREFILL_API_BASE=https://api.bitrefill.com/v2

# HMAC-SHA256 secret used to verify webhook payloads. Generate with:
#   PowerShell: $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $b=New-Object byte[] 32; $rng.GetBytes($b); ($b|%{ '{0:x2}' -f $_ }) -join ''
#   Bash:       openssl rand -hex 32
# Paste the same value into the Bitrefill dashboard's webhook settings.
BITREFILL_WEBHOOK_SECRET=your-64-char-hex-secret

# ============================================
# Logo.dev (brand logos for the gift card catalog)
# ============================================
# Publishable token from https://www.logo.dev/ — safe to expose in the browser.
# If unset, the catalog falls back to colored letter avatars.
NEXT_PUBLIC_LOGO_DEV_TOKEN=pk_live_your-token-here

# ============================================
# Umbra Privacy SDK v2 Configuration
# ============================================
# Docs: https://sdk.umbraprivacy.com/introduction
# Fee: 35 BPS (~0.21%) — floor(amount × 35 / 16384)
# Devnet program: 342qFp62fzTt4zowrVPhrDdcRLGapPCMe8w5kFSoJ4f4
# Mainnet program: UMBRAD2ishebJTcgCLkTkNUx1v3GyoAgpTRPeWoLykh
#
# Umbra Indexer & Relayer URLs (auto-selected based on network — override only if needed)
# Mainnet defaults:
#   NEXT_PUBLIC_UMBRA_INDEXER_URL=https://utxo-indexer.api.umbraprivacy.com
#   NEXT_PUBLIC_UMBRA_RELAYER_URL=https://relayer.api.umbraprivacy.com
# Devnet defaults:
#   NEXT_PUBLIC_UMBRA_INDEXER_URL=https://utxo-indexer.api-devnet.umbraprivacy.com
#   NEXT_PUBLIC_UMBRA_RELAYER_URL=https://relayer.api-devnet.umbraprivacy.com

# ============================================
# Umbra Privacy (Payroll backend)
# ============================================
# Network for the payroll dashboard's Umbra ops. devnet | mainnet-beta
UMBRA_NETWORK=devnet

# Umbra indexer endpoint. Override for self-hosted indexers.
UMBRA_INDEXER_URL=https://utxo-indexer.api.umbraprivacy.com

# Umbra relayer endpoint (used to pay gas for stealth-address claim ops).
UMBRA_RELAYER_URL=https://relayer.api.umbraprivacy.com

# Hoppy-controlled escrow secret. Used to deterministically derive a per-business
# Umbra signer (so server-side issuance doesn't require N Privy signatures).
# Generate with: openssl rand -hex 32
UMBRA_ESCROW_MASTER_KEY=your-64-char-hex-key

# ============================================
# Hoppy Relayer (for SPL token private transfers)
# ============================================
# Private key (base58) of a funded wallet that sends tiny SOL amounts to Eph2 wallets
# This preserves privacy by avoiding direct Eph1→Eph2 links
# Keep this wallet funded with at least 0.1 SOL
HOPPY_RELAYER_PRIVATE_KEY=your-relayer-wallet-base58-private-key

# Optional: Helius API key for /api/sol-price (Helius DAS getAsset). If unset, we use
# api-key from NEXT_PUBLIC_SOLANA_RPC_URL when it's a Helius URL; else CoinGecko fallback.
HELIUS_API_KEY=your-helius-api-key

# ============================================
# Private Gift Card Configuration
# ============================================
# Secret for authenticating cron calls to /api/card/poll-bitrefill
CRON_SECRET=your-random-secret-string

# Public app URL — used to build the claim link and the Bitrefill webhook URL
NEXT_PUBLIC_APP_URL=https://hoppy.cash

# ============================================
# Database Configuration (Railway PostgreSQL)
# ============================================
# Railway auto-injects this when you link a PostgreSQL database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hoppy

# ============================================
# Telegram Bot Configuration
# ============================================
# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 32-byte hex key for encrypting user wallet private keys at rest
# Generate with: openssl rand -hex 32
TELEGRAM_BOT_MASTER_KEY=your-64-char-hex-key

# Optional webhook secret for verifying Telegram requests
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# AI / NLP Configuration (for Telegram bot intent parsing)
# ============================================
# Anthropic API key for Claude Haiku intent classification
# Without this, the bot falls back to regex-only parsing (still works, just less smart)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
